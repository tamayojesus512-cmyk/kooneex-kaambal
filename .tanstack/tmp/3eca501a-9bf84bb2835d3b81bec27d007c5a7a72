import { createFileRoute, Link } from "@tanstack/react-router";
import { useMemo, useState, useEffect } from "react";
import { motion, AnimatePresence } from "framer-motion";
import { dictionary, type DictEntry } from "@/lib/maya-data";
import { SpeakerButton } from "@/components/SpeakerButton";
import { ArrowLeft, Check, X, RotateCcw, Trophy } from "lucide-react";

export const Route = createFileRoute("/juegos/flasgcards")({
  head: () => ({ meta: [{ title: "Flashcards · Juegos · ¡Ko'one'ex Kaambal!" }] }),
  component: FlashcardsPage,
});

function shuffle<T>(a: T[]): T[] { return [...a].sort(() => Math.random() - 0.5); }

function FlashcardsPage() {
  const [seed, setSeed] = useState(0);
  const deck = useMemo<DictEntry[]>(() => shuffle(dictionary).slice(0, 15), [seed]);
  const [i, setI] = useState(0);
  const [flip, setFlip] = useState(false);
  const [known, setKnown] = useState(0);
  const [unknown, setUnknown] = useState(0);
  const done = i >= deck.length;

  useEffect(() => {
    if (done) {
      const prev = Number(localStorage.getItem("kaambal.scores.flashcards") || 0);
      if (known > prev) localStorage.setItem("kaambal.scores.flashcards", String(known));
    }
  }, [done, known]);

  function answer(ok: boolean) {
    if (ok) setKnown(k => k + 1); else setUnknown(u => u + 1);
    setFlip(false);
    setI(n => n + 1);
  }
  function restart() { setSeed(s => s + 1); setI(0); setFlip(false); setKnown(0); setUnknown(0); }

  const card = deck[i];

  return (
    <div className="mx-auto max-w-2xl px-4 sm:px-6 py-10 sm:py-16">
      <Link to="/juegos" className="inline-flex items-center gap-2 text-xs text-muted-foreground hover:text-foreground mb-6"><ArrowLeft className="h-3 w-3" /> volver a juegos</Link>
      <header className="mb-6 text-center">
        <p className="text-xs uppercase tracking-[0.3em] text-cinnabar mb-3">— Flashcards</p>
        <h1 className="font-display text-3xl sm:text-5xl">Voltea, escucha, <em className="text-gradient-gold">repasa</em>.</h1>
      </header>

      {!done ? (
        <>
          <div className="flex items-center justify-between text-xs uppercase tracking-wider text-muted-foreground mb-4">
            <span>{i + 1} / {deck.length}</span>
            <span>Sé: <span className="text-jade font-semibold">{known}</span> · No sé: <span className="text-cinnabar font-semibold">{unknown}</span></span>
          </div>

          <div className="perspective-[1200px]">
            <motion.button
              onClick={() => setFlip(f => !f)}
              className="w-full aspect-[4/3] sm:aspect-[16/10] relative"
              animate={{ rotateY: flip ? 180 : 0 }}
              transition={{ duration: 0.55 }}
              style={{ transformStyle: "preserve-3d" }}
            >
              <div className="absolute inset-0 card-ritual rounded-3xl grid place-items-center p-6 text-center backface-hidden">
                <div>
                  <p className="text-[10px] uppercase tracking-[0.3em] text-cinnabar mb-3">{card.categoria} · {card.tipo}</p>
                  <p className="font-display text-4xl sm:text-6xl text-gold">{card.maya}</p>
                  <div className="mt-5 inline-flex"><SpeakerButton word={card.maya} /></div>
                  <p className="mt-5 text-xs text-muted-foreground">toca la carta para ver el significado</p>
                </div>
              </div>
              <div className="absolute inset-0 card-ritual rounded-3xl grid place-items-center p-6 text-center backface-hidden" style={{ transform: "rotateY(180deg)" }}>
                <div>
                  <p className="text-[10px] uppercase tracking-[0.3em] text-cinnabar mb-3">significado</p>
                  <p className="font-display text-3xl sm:text-4xl">{card.es}</p>
                  {card.ejemplo && <p className="mt-4 text-sm italic text-muted-foreground">«{card.ejemplo}»<br/>«{card.ejemploEs}»</p>}
                </div>
              </div>
            </motion.button>
          </div>

          <div className="mt-6 grid grid-cols-2 gap-3">
            <button onClick={() => answer(false)} className="rounded-xl border border-cinnabar/50 bg-cinnabar/10 text-cinnabar py-3 font-medium inline-flex items-center justify-center gap-2 hover:bg-cinnabar/20 transition">
              <X className="h-4 w-4" /> No sé
            </button>
            <button onClick={() => answer(true)} className="rounded-xl border border-jade/50 bg-jade/10 text-jade py-3 font-medium inline-flex items-center justify-center gap-2 hover:bg-jade/20 transition">
              <Check className="h-4 w-4" /> Sé
            </button>
          </div>
        </>
      ) : (
        <AnimatePresence>
          <motion.div initial={{ opacity: 0, scale: 0.95 }} animate={{ opacity: 1, scale: 1 }} className="card-ritual rounded-3xl p-8 text-center">
            <Trophy className="h-12 w-12 text-gold mx-auto mb-4" />
            <p className="font-display text-3xl">{known} / {deck.length}</p>
            <p className="text-sm text-muted-foreground mt-2">palabras dominadas en esta ronda</p>
            <button onClick={restart} className="mt-6 inline-flex items-center gap-2 rounded-full bg-cinnabar text-primary-foreground px-6 py-3 font-medium">
              <RotateCcw className="h-4 w-4" /> Nueva ronda
            </button>
          </motion.div>
        </AnimatePresence>
      )}

      <style>{`.backface-hidden { backface-visibility: hidden; -webkit-backface-visibility: hidden; }`}</style>
    </div>
  );
}
